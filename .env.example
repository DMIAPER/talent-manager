# =============================================================================
# Talent Manager Pro - Variables de Entorno (Plantilla)
# =============================================================================
# INSTRUCCIONES:
# 1. Copia este archivo y renómbralo exactamente como '.env'
# 2. Rellena tu clave de Google Gemini (y las opcionales si dispones de ellas)
# 3. NUNCA subas el archivo '.env' real a GitHub o repositorios públicos
# =============================================================================

# Google Gemini API Key (Requerido para razonamiento IA, auditoría ATS y análisis de certificados)
# Puedes obtener tu clave gratuita en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=""

# Modelo oficial de Google Gemini a utilizar (Recomendado: gemini-flash-latest o gemini-2.5-flash)
GEMINI_MODEL="gemini-flash-latest"

# Claves opcionales para futuros servicios o búsquedas ampliadas
OPENAI_API_KEY=""
TAVILY_API_KEY=""
