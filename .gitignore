# =============================================================================
# Talent Manager Pro - .gitignore
# Reglas de exclusión para evitar subir credenciales, archivos privados o dependencias
# =============================================================================

# 1. Variables de Entorno y Claves Secretas (CRÍTICO)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!*.env.example

# 2. Documentos Personales, CV y Certificados del Usuario (PRIVACIDAD)
assets/certificates/*
!assets/certificates/.gitkeep
assets/cv-maestro.md
!assets/cv-maestro.example.md

# 3. Base de Datos Local y Datos Personales en JSON (DATOS SENSIBLES)
backend/data/*.json
!backend/data/*.example.json
!backend/data/.gitkeep

# 4. Dependencias y Paquetes de Node.js
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# 5. Compilaciones y Salidas de Build
dist/
**/dist/
build/
**/build/
out/
.next/
*.tsbuildinfo

# 6. Caché y Archivos de Python
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# 7. Testing y Cobertura
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# 8. Archivos Temporales de Trabajo y Scratch
scratch/
**/scratch/*
!scratch/.gitkeep
*.tmp
*.temp
*.log

# 9. Archivos de Sistema Operativo e IDEs
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Tt]humbs.db
.idea/
*.sublime-workspace
*.sublime-project
